    "@types/react-dom": "^19.2.3",
    "i18n-iso-countries": "^7.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "react-simple-maps": "^3.0.0",
